# Copy this file to .env.local. Never commit .env.local.
# Vercel detects its production hostname automatically; set APP_URL only for localhost or a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional, but recommended for a public beta. Keep this server-side only.
GOOGLE_BOOKS_API_KEY=
